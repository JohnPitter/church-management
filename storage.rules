rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isAuthenticated()
        && userDoc().status == 'approved';
    }

    function hasRole(role) {
      return isAuthenticated() && userDoc().role == role;
    }

    function isStaff() {
      return hasRole('admin') || hasRole('secretary');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isImageOrPdf() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function isImage() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isMedia() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Profile photos - own path only
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && isImage();
    }

    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isApproved() && isStaff() && isImage();
    }

    match /event-images/{allPaths=**} {
      allow read: if true;
      allow write: if isApproved() && isStaff() && isImage();
    }

    match /member-photos/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isApproved() && isStaff() && isImage();
    }

    match /assistido-photos/{allPaths=**} {
      allow read: if isAuthenticated() && isApproved()
        && (isStaff() || hasRole('professional'));
      allow write: if isApproved()
        && (isStaff() || hasRole('professional'))
        && isImageOrPdf();
    }

    match /streams/thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isApproved() && isStaff() && isImage();
    }

    match /devotional-media/{allPaths=**} {
      allow read: if true;
      allow write: if isApproved() && isStaff() && isMedia();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
