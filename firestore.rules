rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS (RBAC alinhado a Permission.ts)
    // ========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return userExists() && getUserData().status == 'approved';
    }

    function hasRole(role) {
      return userExists() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSecretary() {
      return hasRole('secretary');
    }

    function isFinance() {
      return hasRole('finance');
    }

    function isProfessional() {
      return hasRole('professional');
    }

    function isLeader() {
      return hasRole('leader');
    }

    function isEducator() {
      return hasRole('educator');
    }

    function isPedagogicalCoordinator() {
      return hasRole('pedagogical_coordinator');
    }

    function isStaff() {
      return isAdmin() || isSecretary();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Conteúdo público (blog, eventos, etc.): escrita por staff
    function canWriteContent() {
      return isApproved() && isStaff();
    }

    // Eventos/projetos: staff ou líder
    function canWriteEventsOrProjects() {
      return isApproved() && (isStaff() || isLeader());
    }

    // Membros: leitura para approved (aniversários, diretório básico da igreja);
    // escrita só staff. Refinar PII depois com projeção/collection pública.
    function canReadMembers() {
      return isApproved();
    }

    function canWriteMembers() {
      return isApproved() && isStaff();
    }

    // Finanças / doações / patrimônio
    function canAccessFinance() {
      return isApproved() && (isAdmin() || isFinance());
    }

    // Assistência / assistidos / agendamentos
    function canAccessAssistance() {
      return isApproved() && (isStaff() || isProfessional());
    }

    // Fichas clínicas: staff e profissionais (dado sensível)
    function canAccessFichas() {
      return isApproved() && (isAdmin() || isProfessional() || isSecretary());
    }

    // Visitantes
    function canManageVisitors() {
      return isApproved() && isStaff();
    }

    // ONG
    function canManageOng() {
      return isApproved() && isStaff();
    }

    function canAccessPedagogy() {
      return isApproved() && (isStaff() || isPedagogicalCoordinator() || isEducator() || isAdmin());
    }

    function canManagePedagogy() {
      return isApproved() && (isAdmin() || isPedagogicalCoordinator() || isSecretary());
    }

    // Notificações em massa
    function canCreateNotifications() {
      return isApproved() && (isStaff() || isAdmin());
    }

    // Usuário não eleva role/status no próprio update
    function notChangingPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'approvedBy', 'approvedAt', 'permissions']);
    }

    // Auto-registro de conta: só o próprio uid, role member, status pending
    function isSelfRegistrationCreate(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
    }

    function isVisitorSelfRegistrationCreate() {
      return !isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'status', 'followUpStatus', 'firstVisitDate',
          'totalVisits', 'contactAttempts', 'interests', 'isMember',
          'createdBy', 'createdAt', 'updatedAt', 'howDidYouKnow', 'observations',
          'selfRegistration', 'jaCristao', 'primeiraVez', 'receberComunicacoes',
          'tipoQuemTrouxe', 'nomeQuemTrouxe'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'status', 'followUpStatus', 'firstVisitDate',
          'totalVisits', 'contactAttempts', 'interests', 'isMember',
          'createdBy', 'createdAt', 'updatedAt', 'howDidYouKnow', 'observations',
          'selfRegistration', 'jaCristao', 'primeiraVez', 'receberComunicacoes',
          'tipoQuemTrouxe', 'nomeQuemTrouxe'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.status == 'active'
        && request.resource.data.followUpStatus == 'pending'
        && request.resource.data.firstVisitDate is timestamp
        && request.resource.data.totalVisits == 1
        && request.resource.data.contactAttempts is list
        && request.resource.data.contactAttempts.size() == 0
        && request.resource.data.interests is list
        && request.resource.data.interests.size() == 0
        && request.resource.data.isMember == false
        && request.resource.data.createdBy == 'self-registration'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.howDidYouKnow is string
        && request.resource.data.observations is string
        && request.resource.data.selfRegistration == true
        && request.resource.data.jaCristao is bool
        && request.resource.data.primeiraVez is bool
        && request.resource.data.receberComunicacoes is bool
        && request.resource.data.tipoQuemTrouxe is string
        && request.resource.data.nomeQuemTrouxe is string;
    }

    // ========================================
    // USERS
    // create: self-register member/pending OU admin (bootstrap via CF preferencial)
    // update role/status: só admin
    // ========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff() || isFinance() || isProfessional();
      allow create: if isSelfRegistrationCreate(userId) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId) && notChangingPrivilegedUserFields());
      allow delete: if isAdmin();
    }

    // ========================================
    // PUBLIC READ - write por staff (conteúdo)
    // ========================================
    match /events/{docId} {
      allow read: if true;
      allow create, update: if canWriteEventsOrProjects();
      allow delete: if isStaff();
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update: if canWriteEventsOrProjects();
      allow delete: if isStaff();
    }

    match /devotionals/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /devotionalCategories/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /devotionalPlans/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /eventCategories/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /liveStreams/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /leaders/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /homeLayouts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appScreens/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeSettings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{docId} {
      allow read: if true;
      // create system/settings só admin (bootstrap CF ou admin)
      allow write: if isAdmin();
    }

    match /publicPageSettings/{docId} {
      allow read: if true;
      // impede spam público: só autenticado cria uma vez; update/delete admin
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ========================================
    // FORUM / COMENTÁRIOS
    // ========================================
    match /forumCategories/{docId} {
      allow read: if true;
      allow write: if canWriteContent();
    }

    match /forumTopics/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    match /forumReplies/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isDocOwner() || isStaff());
      allow delete: if isStaff();
    }

    match /devotionalComments/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isDocOwner() || isStaff());
      allow delete: if isStaff();
    }

    match /likes/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isDocOwner();
    }

    // Viewers de live: create/update público limitado; sem delete em massa aberto
    match /liveViewers/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    match /streamViewers/{streamId} {
      allow read: if true;
      match /viewers/{viewerId} {
        allow read, create, update: if true;
        allow delete: if isStaff();
      }
      match /totalViewers/{viewerId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    // ========================================
    // MEMBERS / VISITORS
    // ========================================
    match /members/{docId} {
      allow read: if canReadMembers();
      allow write: if canWriteMembers();
    }

    match /visitors/{docId} {
      allow read, update, delete: if canManageVisitors();
      allow create: if canManageVisitors() || isVisitorSelfRegistrationCreate();
    }

    match /voluntarios/{docId} {
      allow read: if isAuthenticated() && (canManageOng() || isApproved());
      allow write: if canManageOng();
    }

    // ========================================
    // OWNER-BASED
    // ========================================
    match /notificationPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /notifications/{docId} {
      allow read: if isDocOwner();
      allow create: if canCreateNotifications()
        && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'status'])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0;
      allow update: if isDocOwner();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /prayerRequests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // update: comunidade (Orar) + staff
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    match /eventConfirmations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner() || isStaff();
    }

    match /projectRegistrations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner() || isStaff();
    }

    match /userDevotionalProgress/{docId} {
      allow read: if isAuthenticated() && (isDocOwner() || isStaff());
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner();
    }

    match /userPlanProgress/{docId} {
      allow read: if isAuthenticated() && (isDocOwner() || isStaff());
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner();
    }

    match /forumActivities/{docId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    match /forumNotifications/{docId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isDocOwner();
    }

    match /userForumProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isStaff();
    }

    // ========================================
    // FINANCIAL
    // ========================================
    match /transactions/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /donations/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /budgets/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /financialCategories/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_budgets/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_categories/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_transactions/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_donations/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_departments/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_department_transactions/{docId} {
      allow read, write: if canAccessFinance();
    }
    match /church_department_transfers/{docId} {
      allow read, write: if canAccessFinance();
    }

    // ========================================
    // ONG
    // ========================================
    match /ongSettings/{docId} {
      allow read, write: if canManageOng();
    }
    match /ongVolunteers/{docId} {
      allow read, write: if canManageOng();
    }
    match /ongActivities/{docId} {
      allow read, write: if canManageOng();
    }
    match /atividadesONG/{docId} {
      allow read, write: if canManageOng();
    }
    match /doacoesONG/{docId} {
      allow read, write: if canManageOng() || canAccessFinance();
    }
    match /ongInfo/{docId} {
      allow read: if true;
      allow write: if canManageOng();
    }
    match /ong_budgets/{docId} {
      allow read, write: if canManageOng() || canAccessFinance();
    }
    match /ong_categories/{docId} {
      allow read, write: if canManageOng() || canAccessFinance();
    }
    match /ong_transactions/{docId} {
      allow read, write: if canManageOng() || canAccessFinance();
    }

    // ========================================
    // ASSISTANCE / CLÍNICO
    // ========================================
    match /assistidos/{docId} {
      allow read, write: if canAccessAssistance();
    }
    match /assistencias/{docId} {
      allow read, write: if canAccessAssistance();
    }
    match /agendamentosAssistencia/{docId} {
      allow read, write: if canAccessAssistance();
    }
    match /profissionaisAssistencia/{docId} {
      allow read: if isApproved();
      allow write: if isStaff();
    }
    match /atendimentos/{docId} {
      allow read, write: if canAccessAssistance();
    }

    match /professional_help_requests/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.destinatarioId == request.auth.uid ||
        canAccessAssistance()
      );
      allow create: if canAccessAssistance();
      allow update: if isAuthenticated() && (
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.destinatarioId == request.auth.uid ||
        canAccessAssistance()
      );
      allow delete: if isStaff();
    }

    match /professional_help_request_comments/{docId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && (isDocOwner() || canAccessAssistance());
      allow delete: if isStaff();
    }

    match /fichasAcompanhamento/{docId} {
      allow read, write: if canAccessFichas();
      match /sessoes/{sessaoId} {
        allow read, write: if canAccessFichas();
      }
    }

    match /pedagogicalGuidelines/{docId} {
      allow read: if canAccessPedagogy();
      allow write: if canManagePedagogy();
    }
    match /classSessionRecords/{docId} {
      allow read: if canAccessPedagogy();
      allow create, update: if canAccessPedagogy();
      allow delete: if canManagePedagogy();
    }
    match /studentDifficultyRecords/{docId} {
      allow read: if canAccessPedagogy();
      allow create, update: if canAccessPedagogy();
      allow delete: if canManagePedagogy();
    }
    match /guidelineApplications/{docId} {
      allow read: if canAccessPedagogy();
      allow create, update: if canAccessPedagogy();
      allow delete: if canManagePedagogy();
    }
    match /pedagogicalFeedback/{docId} {
      allow read: if canAccessPedagogy();
      allow create: if canManagePedagogy();
      allow update, delete: if canManagePedagogy();
    }

    // ========================================
    // ASSETS
    // ========================================
    match /assets/{docId} {
      allow read, write: if canAccessFinance() || isStaff();
    }

    // ========================================
    // PERMISSIONS / AUDIT / BACKUP
    // ========================================
    match /rolePermissions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /userPermissionOverrides/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /customRoles/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /systemLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /permissionAudit/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /system_backups/{docId} {
      allow read, write: if isAdmin();
    }
    match /backups/{docId} {
      allow read, write: if isAdmin();
    }
    match /backup_metadata/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
